# COPY to .env.staging on the STAGING SERVER. Never commit the filled file.
# Stripe test keys and database secrets must come from an approved secret store.
# Generate three DIFFERENT strong passwords and URL-encode DATABASE_URL's password.

# S35 read-only staging readiness (no deployment, public DNS or provider access).
# Use an independently reviewed exact CI-green integration SHA, never a branch name.
EPMO_SYNTHETIC_ONLY=YES
EPMO_DEPLOY_SHA=
STAGING_EDGE_BIND=127.0.0.1
STAGING_EDGE_HTTPS_PORT=8443
# Staging-only certificate/key outside repository, with private key chmod 600.
STAGING_TLS_CERT_PATH=
STAGING_TLS_KEY_PATH=
ALLOW_HEADER_AUTH=false

PG_USER=pmo_admin
PG_PASSWORD=
PG_DB=pmo
REDIS_PASSWORD=
DATABASE_URL=postgres://pmo_app:REPLACE_WITH_LONG_URL_ENCODED_PASSWORD@postgres:5432/pmo
REDIS_URL=redis://:REPLACE_WITH_LONG_URL_ENCODED_PASSWORD@redis:6379

WEB_ORIGIN=https://staging.theepmo.com
PUBLIC_API_URL=https://api-staging.theepmo.com
WEB_PORT=3001
WEB_BIND=127.0.0.1

# Staging must run a production-built application with ONLY Stripe test keys.
DEPLOYMENT_ENV=staging
NODE_ENV=production
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_TEST_MODE_IN_PRODUCTION=true
STRIPE_WEBHOOK_PUBLIC_URL=https://api-staging.theepmo.com/api/v1/billing/stripe-webhook
BILLING_REFERENCE_WEBHOOK_ENABLED=false

# Phase 13A invitations: disabled until SES sender/domain verification.
MAIL_TRANSPORT=none
MAIL_FROM=
MAIL_REGION=ap-south-1
