# Copy to .env.prod and fill in. Nothing here may keep a default value.
PG_USER=pmo_admin
PG_PASSWORD=              # long random string
PG_DB=pmo
REDIS_PASSWORD=           # long random string

# The API connects as the RLS-bound application role, never as the admin user.
DATABASE_URL=postgres://pmo_app:CHANGE_ME@postgres:5432/pmo
REDIS_URL=redis://:CHANGE_ME@redis:6379

# Must be https. Used by BOTH API CORS and web origin/redirect protection.
# If multiple origins are served, provide a comma-separated allowlist.
WEB_ORIGIN=https://theepmo.com
# Replace with your actual deployed API HTTPS hostname after DNS/TLS verification.
PUBLIC_API_URL=https://api.pmo.example.com

# Host port for the web container (default 3000).
WEB_PORT=3000
# P0: keep the web container private to localhost; expose HTTPS via a reverse proxy.
WEB_BIND=127.0.0.1

# ── notifications ────────────────────────────────────────────────────────
# Unset (or 'none') records notifications without sending them, which is the
# right state until the sending domain is verified. 'ses' needs MAIL_FROM to
# be an address on a verified identity.
MAIL_TRANSPORT=none
MAIL_FROM=
MAIL_REGION=ap-south-1
MAIL_CONFIGURATION_SET=align360

# ── Microsoft 365 (SharePoint, OneDrive, Power BI) ───────────────────────
# Optional. Leave blank and the Integrations page says Microsoft is not
# configured, which is true, rather than offering a button that cannot work.
# Registration steps: docs/microsoft-setup.md
#
# The redirect URI must match the one registered in Entra ID exactly, including
# the scheme and any trailing path. It is on WEB_ORIGIN, not the API: only the
# web app is published through nginx, so a URI pointing at the API would be
# accepted by Microsoft and then 404 in the browser.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://theepmo.com/integrations/microsoft/callback
# Encrypts the stored refresh token:  openssl rand -base64 32
# Keep it. Changing it leaves every existing connection unreadable and every
# customer has to connect again.
MS_TOKEN_KEY=

# Billing reference adapter remains OFF until a PSP-native integration is approved.
BILLING_REFERENCE_WEBHOOK_ENABLED=false
BILLING_REFERENCE_WEBHOOK_SECRET=

# Stripe hosted one-time renewal Checkout (OFF until credentials/configuration validated)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Register https://<public API hostname>/api/v1/billing/stripe-webhook on Stripe.
# Stripe Checkout redirects customers to WEB_ORIGIN; redirects never grant access.

# Production defaults: never enable the staging exemption in live deployments.
DEPLOYMENT_ENV=production
STRIPE_ALLOW_TEST_MODE_IN_PRODUCTION=false
# Documentation/preflight hint; the API itself uses /api/v1/billing/stripe-webhook.
STRIPE_WEBHOOK_PUBLIC_URL=
