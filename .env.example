# Demo reseed is DESTRUCTIVE. Never add PHASE15_ACCEPT_DISPOSABLE_DB here.
# Instead pass its acknowledgement explicitly in the shell for disposable local setup.
# NODE_ENV=development is also required by the demo seeder.
# Admin connection — migrations, schema push, seeding (bypasses RLS)
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5433/pmo

# Runtime connection — application role, RLS ENFORCED. Never use the admin URL here.
DATABASE_URL=postgres://pmo_app:pmo_app@localhost:5433/pmo

REDIS_URL=redis://localhost:6380
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Exact comma-separated browser origins allowed for credentialed API calls, web form writes, and redirects.
# The production web and API processes must receive the same WEB_ORIGIN value.
# In production EVERY origin must use HTTPS; never use a wildcard.
WEB_ORIGIN=http://localhost:3000
# Set to the number of reverse proxies in front of the API. Use 0 for direct connections.
# An incorrect value can allow spoofed client IPs and undermine rate limiting.
TRUST_PROXY_HOPS=1

# Sign-in attempts per minute per IP. Production caps this at 20; tests need more.
LOGIN_RATE_LIMIT=500

# ── Ask X (Bedrock) ──────────────────────────────────────────────────────
# ASKX_ENABLED=false switches the assistant off entirely.
# BEDROCK_MODEL_ID is an env var because model access is granted per account:
# newer Claude models need one enablement in the Bedrock console, and until
# that happens the older one is what answers.
AWS_PROFILE=
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ── Microsoft 365 (SharePoint, OneDrive, Power BI) ───────────────────────
# One multi-tenant app registration in Entra ID, consented to separately by
# each customer inside their own Microsoft tenant. Their files stay in their
# tenancy; The EPMO stores a pointer and a refresh token, nothing else.
# Leave these blank and the Integrations page says so rather than failing.
# Setup steps: docs/microsoft-setup.md
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/integrations/microsoft/callback
# Encrypts the stored refresh token. 32 random bytes:  openssl rand -base64 32
# Changing it makes every existing connection unreadable, so they reconnect.
MS_TOKEN_KEY=
# Which Microsoft accounts may connect. 'organizations' is work and school
# accounts only, which is what Power BI needs; 'common' also allows personal
# Microsoft accounts, which can use OneDrive but not Power BI.
# MS_AUTHORITY=https://login.microsoftonline.com/organizations

# Phase 12 billing: reference HMAC event adapter (NOT a payment-provider integration).
# Disabled by default. Use only in a controlled trusted-adapter integration environment.
BILLING_REFERENCE_WEBHOOK_ENABLED=false
# Required (>=32 random bytes) only if explicitly enabled. Never expose to the web client.
BILLING_REFERENCE_WEBHOOK_SECRET=

# Native Stripe hosted checkout (optional, disabled by default)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe test-mode staging with a production-optimized Node build.
# NEVER set these staging overrides in your live production deployment.
DEPLOYMENT_ENV=development
STRIPE_ALLOW_TEST_MODE_IN_PRODUCTION=false
# Used by the staging preflight only. Must be publicly reachable by Stripe.
STRIPE_WEBHOOK_PUBLIC_URL=

# Phase 13A secure invitations: disabled unless a verified SES sender is configured.
MAIL_TRANSPORT=none
MAIL_FROM=
MAIL_REGION=ap-south-1
