{
  "name": "the-epmo",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:push": "pnpm --filter @pmo/db push",
    "db:rls": "pnpm --filter @pmo/db rls",
    "db:seed": "pnpm --filter @pmo/db seed",
    "db:setup": "pnpm db:push && pnpm db:rls && pnpm db:modules && pnpm db:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "build:packages": "pnpm --filter @pmo/contracts build && pnpm --filter @pmo/db build",
    "predev": "pnpm build:packages",
    "verify:rls": "pnpm --filter @pmo/db verify",
    "setup": "pnpm infra:up && sleep 6 && pnpm build:packages && pnpm db:push && pnpm db:rls && pnpm db:seed && pnpm verify:rls",
    "smoke": "bash scripts/smoke.sh",
    "pages": "bash scripts/pages.sh",
    "shots": "node scripts/shots.mjs",
    "sweep": "node scripts/sweep.mjs",
    "check:data": "pnpm --filter @pmo/db check:data",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm check:shadow && pnpm check:dict && pnpm check:data && pnpm verify:rls && pnpm test",
    "db:migrate": "bash scripts/apply-sql-migrations.sh",
    "db:generate": "pnpm --filter @pmo/db generate",
    "clean": "pnpm --filter @pmo/web clean && rm -rf apps/api/dist packages/*/dist",
    "db:modules": "pnpm --filter @pmo/db modules",
    "check:shadow": "node scripts/shadow.mjs",
    "check:dict": "node scripts/dict.mjs",
    "verify:static": "node scripts/verify-release-static.mjs",
    "verify:runtime-preflight": "node scripts/runtime-preflight.mjs",
    "verify:migrations": "node scripts/verify-migration-chain.mjs",
    "verify:rc1": "node scripts/rc1-release-gate.mjs",
    "test:offline": "node --experimental-strip-types --test apps/api/src/platform/*.test.mjs apps/api/src/onboarding/*.test.mjs apps/api/src/creates/*.test.mjs apps/web/src/lib/*.test.mjs packages/db/src/*.test.mjs scripts/*.test.mjs tests/*.test.mjs scripts/verify-staging-config.test.mjs",
    "verify:stripe:staging": "node scripts/stripe-staging-preflight.mjs",
    "test:stripe:evidence": "node --test scripts/stripe-staging-evidence.test.mjs",
    "verify:stripe:evidence": "node scripts/stripe-staging-evidence.mjs",
    "test:stripe:db-rls": "node --test scripts/stripe-db-rls-audit.test.mjs",
    "verify:stripe:db-rls": "node scripts/stripe-db-rls-audit.mjs",
    "verify:build-artifacts": "node scripts/verify-build-artifacts.mjs --scope all",
    "verify:web:acceptance": "bash scripts/phase15d-run-web-smoke.sh",
    "verify:staging-config": "node scripts/verify-staging-config.mjs --env-file .env.staging"
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "playwright": "^1.63.0",
    "vitest": "^5.0.0"
  }
}
